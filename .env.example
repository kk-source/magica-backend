# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/magica

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Origin of the frontend app (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Trigger.dev (https://cloud.trigger.dev)
TRIGGER_SECRET_KEY=tr_dev_xxx
# TRIGGER_PROJECT_ID is also accepted
TRIGGER_PROJECT_REF=proj_xxx

# OpenRouter (free models)
OPENROUTER_API_KEY=sk-or-xxx
OPENROUTER_MODEL=openrouter/free

# Credits granted at signup, and the balance needed to start a turn
STARTING_CREDITS=1000
MIN_RUN_CREDITS=250
# Paid tools estimated at or above this many credits ask for approval first (0 = always ask),
# and how long a paused run waits for the answer
CREDIT_APPROVAL_MIN=50
WAITPOINT_TIMEOUT_MINUTES=15

# Magica
MAGICA_API_KEY=xxx
MAGICA_API_BASE_URL=https://inference.magica.com/v1

# Transloadit
TRANSLOADIT_KEY=xxx
TRANSLOADIT_SECRET=xxx
# Optional; without it uploads use inline /upload/handle steps (files stay on Transloadit temp storage ~24h)
TRANSLOADIT_TEMPLATE_ID=
